# LOCAL (utilise par `npm run dev`, jamais par un build)
# Meme comportement que la preprod : FULL par defaut, ?mode=prelaunch pour previsualiser.
# VITE_APP_URL n'est volontairement pas defini ici, pour ne pas masquer un .env.local.
# Surcharges personnelles : .env.development.local (non versionne).
VITE_ENVIRONMENT=development
VITE_DEFAULT_SITE_MODE=full
