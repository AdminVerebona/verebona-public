# Variables injectees au build par Vite. Voir README > « Modes FULL / PRELAUNCH ».
# Une variable definie dans l'environnement de la plateforme (process.env)
# est prioritaire sur les fichiers .env.

# URL de l'application Verebona (repo verebona-app)
VITE_APP_URL=https://app.verebona.fr

# Environnement de deploiement : development | preprod | production
# Absent ou inconnu => traite comme production (aucune previsualisation par URL).
VITE_ENVIRONMENT=production

# Mode d'affichage par defaut : full | prelaunch
# Absent ou invalide => prelaunch en production, full en preprod / development.
VITE_DEFAULT_SITE_MODE=prelaunch
