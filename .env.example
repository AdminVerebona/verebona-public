# Variables injectees au build par Vite. Voir README > « Modes FULL / PRELAUNCH ».
# Une variable definie dans l'environnement de la plateforme (process.env)
# est prioritaire sur les fichiers .env.

# URL de l'application Verebona (repo verebona-app)
VITE_APP_URL=https://app.verebona.fr

# Origine du site public de l'environnement (chantier 104P) : base des permaliens
# du manifeste des CGUV (/legal/cguv/versions.json). Absente : www.verebona.fr en
# production, preprod.verebona.fr en preprod, http://localhost:3000 en local.
VITE_PUBLIC_SITE_URL=https://www.verebona.fr

# Environnement de deploiement : development | preprod | production
# Absent ou inconnu => traite comme production (aucune previsualisation par URL).
VITE_ENVIRONMENT=production

# Mode d'affichage par defaut : full | prelaunch
# Absent ou invalide => prelaunch en production, full en preprod / development.
VITE_DEFAULT_SITE_MODE=prelaunch

# Source des montants de la section Tarifs (lot 76P) : catalog | prelaunch_fixed
# Absente ou invalide => catalog. prelaunch_fixed (grille temporaire, aucun appel
# a l'API) n'est accepte qu'avec VITE_DEFAULT_SITE_MODE=prelaunch : sinon le build
# echoue. Voir README > « Tarifs : grille temporaire du pre-lancement et bascule ».
VITE_PRICING_SOURCE=prelaunch_fixed

# ── Variables d'EXECUTION de server.cjs (hebergeur, pas Vite) ──────────────
# Production uniquement, a definir chez l'hebergeur : une seule 301 de http:// et
# de l'apex verebona.fr vers https://www.verebona.fr (CDC Donnees structurees §7).
# Ne JAMAIS la definir en preproduction. Voir README > « Deploiement ».
# CANONICAL_HOST=www.verebona.fr
