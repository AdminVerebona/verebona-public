# PROD (utilise par `npm run build`, soit `vite build`)
# PRELAUNCH force : le parametre ?mode= est ignore en production.
# Lancement commercial : passer VITE_DEFAULT_SITE_MODE a full, puis rebuild/redeployer.
VITE_APP_URL=https://app.verebona.fr
VITE_ENVIRONMENT=production
# Origine du site (permaliens du manifeste des CGUV, /legal/cguv/versions.json) : PAS de valeur ici.
# Lot 111O : `npm run build` (Scalingo) lit ce fichier aussi en préproduction ; une origine figée ici
# faisait publier sur le site de préprod un manifeste pointant vers la prod, refusé par l'application
# (inscriptions bloquées le 05/11/2026). L'origine découle de VITE_ENVIRONMENT (production → www,
# preprod → preprod.verebona.fr) ; VITE_PUBLIC_SITE_URL posée sur Scalingo l'emporte.
VITE_DEFAULT_SITE_MODE=prelaunch
# Tarifs (lot 76P) : grille TEMPORAIRE du pre-lancement, sans appel a l'API.
# Bascule vers le catalogue Stripe : passer a catalog UNIQUEMENT apres les
# verifications du README > « Tarifs : grille temporaire du pre-lancement et bascule ».
# prelaunch_fixed avec VITE_DEFAULT_SITE_MODE=full fait echouer le build.
VITE_PRICING_SOURCE=prelaunch_fixed
