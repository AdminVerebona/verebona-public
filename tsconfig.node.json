{
  "compilerOptions": {
    "composite": true,
    "emitDeclarationOnly": true,
    "outDir": "node_modules/.tmp/tsconfig-node",
    "target": "ES2022",
    "lib": ["ES2022"],
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowSyntheticDefaultImports": true,
    "types": ["node"]
  },
  "include": [
    "vite.config.ts",
    "src/config/site-mode.rules.ts",
    "src/config/sitemap.rules.ts",
    "src/config/structured-data.ts",
    "src/config/head.rules.ts",
    "src/config/social.rules.ts",
    "src/config/mode-preview-guard.rules.ts",
    "help.build.ts",
    "src/help/config.ts",
    "src/help/corpus.ts",
    "src/help/coverage.ts",
    "src/help/slug-registry.ts",
    "src/help/frontmatter.ts",
    "src/help/markdown.ts",
    "src/help/outputs.ts",
    "src/help/referentials.ts",
    "src/help/types.ts",
    "ressources.build.ts",
    "src/ressources/corpus.ts",
    "src/ressources/markdown.ts",
    "src/ressources/outputs.ts",
    "src/ressources/types.ts",
    "link-inventory.build.ts",
    "src/router/route-paths.ts",
    "src/config/legacy-routes.rules.ts",
    "src/config/link-inventory.rules.ts"
  ]
}
